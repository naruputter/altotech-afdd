# Application Settings
PROJECT_NAME="Multi-Site AFDD Platform"
API_V1_STR="/api/v1"
DEBUG=True

# Database Configuration (PostgreSQL / TimescaleDB)
POSTGRES_SERVER=localhost
POSTGRES_PORT=5434
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=afdd_db

# Asynchronous Database URL (asyncpg)
# Used inside docker: postgresql+asyncpg://postgres:postgres@timescaledb:5432/afdd_db
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5434/afdd_db

# Security & JWT
SECRET_KEY=supersecret-change-in-production-afdd-jwt-key
ACCESS_TOKEN_EXPIRE_MINUTES=1440
ALGORITHM=HS256

# LLM Agent Configuration
OPENAI_API_KEY=
LLM_MODEL=gpt-4o-mini

# MQTT Broker (NanoMQ) Configuration
MQTT_BROKER_HOST=localhost
MQTT_BROKER_PORT=1883
MQTT_TELEMETRY_TOPIC=telemetry/#
